def graficar_tonos(df, tonos_completos, tipo_tono='mayor'):
    """
    Grafica la cantidad de canciones por tono, diferenciando por relevancia
    y aplicando los colores específicos de la paleta según el tipo de tonalidad.
    """
    plt.figure(figsize=(10, 6))

    color_relevante = (paleta['tonalidad_mayor']
                       if tipo_tono == 'mayor'
                       else paleta['tonalidad_menor'])

    paleta_hue = {
        True: color_relevante,
        False: paleta['no_relevantes']
    }

    sns.countplot(
        data=df,
        x='tono',
        hue='es_relevante',
        order=tonos_completos,
        palette=paleta_hue
    )

    plt.xlabel('Tono', fontsize=12)
    plt.ylabel('Cantidad', fontsize=12)
    plt.title('')

    handles, _ = plt.gca().get_legend_handles_labels()
    plt.legend(handles, ['No relevantes', 'Relevantes'], title="")

    plt.grid(axis='y', alpha=0.3)
    plt.tight_layout()
    plt.show()

