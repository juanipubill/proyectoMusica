def graficar_densidad_duracion(df_epoca, nombre_epoca=""):
    """
    Genera un gráfico de densidad (KDE) comparando la duración de canciones
    relevantes y no relevantes para un dataset específico.
    """
    plt.figure(figsize=(10, 6))

    relevantes = df_epoca[df_epoca['es_relevante'] == True]['duracion_min']
    no_relevantes = df_epoca[df_epoca['es_relevante'] == False]['duracion_min']

    if len(relevantes) > 1:
        sns.kdeplot(relevantes, fill=True, alpha=0.7,
                    color=paleta['relevantes'],
                    label=f'Relevantes (n={len(relevantes)})',
                    bw_adjust=0.5)

    if len(no_relevantes) > 1:
        sns.kdeplot(no_relevantes, fill=True, alpha=0.4,
                    color=paleta['no_relevantes'],
                    label=f'No relevantes (n={len(no_relevantes)})',
                    bw_adjust=0.5)

    plt.xlabel('Duración (minutos)', fontsize=12)
    plt.ylabel('Densidad', fontsize=12)
    plt.title('')  

    plt.ylim(0, 0.53)

    plt.legend(title=f"{nombre_epoca}".strip())

    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()
    
