def graficar_knn_bpm_duracion(df, k=5):

    X = df[['bpm', 'duracion_min']]

    y = df['es_relevante']

    knn = KNeighborsClassifier(n_neighbors=k)

    knn.fit(X, y)

    fig, ax = plt.subplots(figsize=(10, 8))

    datos_rel = df[df['es_relevante'] == True]

    ax.scatter(
        datos_rel['bpm'],
        datos_rel['duracion_min'],
        color='blue',
        alpha=0.7,
        s=70,
        label='Relevantes'
    )

    datos_no_rel = df[df['es_relevante'] == False]

    ax.scatter(
        datos_no_rel['bpm'],
        datos_no_rel['duracion_min'],
        color='red',
        alpha=0.7,
        s=70,
        label='No relevantes'
    )

    ax.set_xlabel('BPM', fontsize=12)
    ax.set_ylabel('Duración (minutos)', fontsize=12)
    ax.set_title(f'KNN (k={k})')

    ax.legend()

    plt.grid(True, alpha=0.3)

    plt.tight_layout()
    plt.show()


