    knn.fit(X_scaled, y)

    x_min, x_max = df['bpm'].min() - 5, df['bpm'].max() + 5
    y_min, y_max = df['duracion_min'].min() - 0.5, df['duracion_min'].max() + 0.5

    xx, yy = np.meshgrid(
        np.arange(x_min, x_max, 1),
        np.arange(y_min, y_max, 0.05)
