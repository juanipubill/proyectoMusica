def graficar_prob_acumulada_por_decadas(df_cancion, df_album, anio_inicio=1960, anio_fin=2020, paso=20):
    """
    Divide los datos en épocas automáticamente, calcula la probabilidad acumulada
    y genera el gráfico comparativo aplicando los colores de tu paleta.
    """
    plt.figure(figsize=(12, 7))

    colores_lineas = [
        paleta['relevantes'],      
        paleta['tonalidad_menor'],   
        paleta['no_relevantes'],
    ]

    cortes_anios = list(range(anio_inicio, anio_fin + paso, paso))

    for idx, i in enumerate(range(len(cortes_anios) - 1)):
        desde = cortes_anios[i]
        hasta = cortes_anios[i+1]

        label_epoca = f"{str(desde)[2:]} - {str(hasta)[2:]}"

        q_epoca = f"""
            SELECT d.*, a.año
            FROM df_cancion AS d
            JOIN df_album AS a ON a.id_album == d.id_album
            WHERE a.año >= {desde} AND a.año < {hasta}
        """
        df_epoca = dd.query(q_epoca).df()

        print(f"Época {label_epoca}: {df_epoca.shape[0]} canciones.")

        if df_epoca.empty:
            continue

        stats = df_epoca.groupby('track_number')['es_relevante'].value_counts().unstack(fill_value=0)

        if True not in stats.columns: stats[True] = 0
        if False not in stats.columns: stats[False] = 0

        stats['cum_R'] = stats[True].cumsum()
        stats['cum_NR'] = stats[False].cumsum()
        stats['porcentaje'] = stats['cum_R'] / (stats['cum_R'] + stats['cum_NR'])

        prob_acumulada = stats.loc[1:18]['porcentaje']

        color_actual = colores_lineas[idx % len(colores_lineas)]

        plt.plot(
            prob_acumulada.index,
            prob_acumulada.values,
            marker='o',
            label=label_epoca,
            linewidth=2,
            color=color_actual
        )

    plt.title('', fontsize=14, fontweight='bold')
    plt.xlabel('Número de Track (acumulado)', fontsize=12)
    plt.ylabel('Probabilidad (0 a 1)', fontsize=12)
    plt.xticks(range(1, 19))
    plt.legend(title="Períodos")

    plt.grid(True, alpha=0.5)
    plt.tight_layout()
    plt.show()

