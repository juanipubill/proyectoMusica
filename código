# Colores variados para cada porción
def get_color_palette(n):
    """Genera n colores distintos usando el mapa 'tab20' que tiene 20 colores diferentes"""
    cmap = plt.cm.tab20
    return [cmap(i % 20) for i in range(n)]

# ===== GRÁFICO 1: RELEVANTES EN MAYORES (lado a lado) =====
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(18, 8))

