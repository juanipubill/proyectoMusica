def plot_relevancia_tonos(df_mayores, df_menores, titulo_epoca):
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 6))
    fig.suptitle(f'Relevancia según Tono - {titulo_epoca}', fontsize=16)

    r_may = df_mayores[df_mayores['es_relevante'] == True].shape[0]
    nr_may = df_mayores[df_mayores['es_relevante'] == False].shape[0]

    r_men = df_menores[df_menores['es_relevante'] == True].shape[0]
    nr_men = df_menores[df_menores['es_relevante'] == False].shape[0]

    colors = ['#66b3ff', '#ff9999']

    ax1.pie([r_may, nr_may], labels=['Relevante', 'No Relevante'], autopct='%1.1f%%',
            startangle=90, colors=colors, explode=(0.05, 0))
    ax1.set_title('Tonos MAYORES')

    ax2.pie([r_men, nr_men], labels=['Relevante', 'No Relevante'], autopct='%1.1f%%',
            startangle=90, colors=colors, explode=(0.05, 0))
    ax2.set_title('Tonos MENORES')

    plt.show()

