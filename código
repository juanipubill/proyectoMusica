def optimizar_knn_por_tono(df, tono, k_range=range(1, 5)):
    df_tono = df[df['tono'] == tono].copy()

    if df_tono.empty:
        print(f"No hay datos para el tono: {tono}")
        return None

    features = ['bpm', 'duracion_min']
    X = df_tono[features].values
    y = df_tono['es_relevante'].values

    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    param_grid = {'n_neighbors': k_range}
    knn = KNeighborsClassifier()
    grid_search = GridSearchCV(knn, param_grid, cv=min(5, len(df_tono)),
                               scoring='accuracy', n_jobs=-1)
    grid_search.fit(X_scaled, y)

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))

    ax1.plot(k_range, grid_search.cv_results_['mean_test_score'], 'bo-', label='Accuracy')
    ax1.fill_between(k_range,
                     grid_search.cv_results_['mean_test_score'] - grid_search.cv_results_['std_test_score'],
                     grid_search.cv_results_['mean_test_score'] + grid_search.cv_results_['std_test_score'],
                     alpha=0.2)
    ax1.axvline(x=grid_search.best_params_['n_neighbors'], color='red',
                linestyle='--', label=f'Mejor k={grid_search.best_params_["n_neighbors"]}')
    ax1.set_xlabel('Número de vecinos (k)')
    ax1.set_ylabel('Accuracy promedio')
    ax1.set_title(f'Tono {tono} - Optimización de KNN')
    ax1.legend()
    ax1.grid(True, alpha=0.3)

    ax2.scatter(df_tono['bpm'], df_tono['duracion_min'],
               c=df_tono['es_relevante'].map({True: paleta['relevantes'], False: paleta['no_relevantes']}),
               alpha=0.7, s=70, edgecolors='black', linewidth=0.5)
    ax2.set_xlabel('BPM')
    ax2.set_ylabel('Duración (minutos)')
    ax2.set_title(f'Tono {tono} - Datos (n={len(df_tono)})')
    ax2.grid(True, alpha=0.3)

    plt.tight_layout()
    plt.show()

    print(f"\nMejor k para tono {tono}: {grid_search.best_params_['n_neighbors']}")
    print(f"Mejor accuracy: {grid_search.best_score_:.3f}")

    return grid_search.best_estimator_, scaler


