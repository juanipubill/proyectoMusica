    tonos_rel = [t for t in tonos_completos_mayores if conteo_rel.get(t, 0) > 0]
    valores_rel = [conteo_rel.get(t, 0) for t in tonos_rel]
    
    colores_rel = get_color_palette(len(tonos_rel))
    
    wedges, texts, autotexts = ax1.pie(valores_rel,
                                        labels=[f"{t}" for t in tonos_rel],
                                        colors=colores_rel,
                                        autopct='%1.1f%%',
                                        startangle=90,
                                        textprops={'fontsize': 11, 'fontweight': 'bold'})
    
    # Agregar leyenda con los conteos
    leyenda_labels = [f"{t}: {conteo_rel.get(t,0)}" for t in tonos_rel]
    ax1.legend(wedges, leyenda_labels, title="Tonos", loc="center left", bbox_to_anchor=(1, 0, 0.5, 1))
