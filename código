               palette={'Relevante': 'blue', 'No relevante': 'red'}, inner='box', alpha=0.7)

# Superponer puntos individuales
sns.stripplot(data=df_plot, x='relevancia', y='duracion_min', ax=ax2,
              color='black', alpha=0.5, size=8, jitter=True)

ax2.set_xlabel('Relevancia', fontsize=12)
ax2.set_ylabel('Duración (minutos)', fontsize=12)
